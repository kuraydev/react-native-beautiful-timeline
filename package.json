{
  "name": "react-native-beautiful-timeline",
  "version": "2.0.0",
  "description": "Fully customizable, beautifully designed Timeline for React Native.",
  "keywords": [
    "react-native",
    "react native timeline",
    "timeline",
    "beautiful",
    "customizable",
    "ios",
    "android",
    "ui-lib",
    "rn"
  ],
  "homepage": "https://github.com/kuraydev/react-native-beautiful-timeline#readme",
  "bugs": {
    "url": "https://github.com/kuraydev/react-native-beautiful-timeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraydev/react-native-beautiful-timeline.git"
  },
  "main": "dist/commonjs/index.js",
  "module": "dist/module/index.js",
  "types": "dist/typescript/index.d.ts",
  "react-native": "dist/module/index.js",
  "source": "lib/index",
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "react-native": "./dist/module/index.js",
      "import": "./dist/module/index.js",
      "require": "./dist/commonjs/index.js",
      "default": "./dist/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.tsbuildinfo"
  ],
  "author": "Kuray (FreakyCoder) <kurayogun@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "moment": ">=2.24.0",
    "react-native-dash-2": ">=0.2.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.61.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-native": {
      "optional": false
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.9.0",
    "@react-native/babel-preset": "0.74.87",
    "@testing-library/react-native": "^12.5.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.9.0",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "react": "18.3.1",
    "react-native": "0.74.5",
    "react-native-builder-bob": "^0.30.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"lib/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"lib/**/*.{ts,tsx}\"",
    "test": "jest",
    "clean": "rm -rf dist build",
    "build": "bob build",
    "prepare": "bob build"
  },
  "lint-staged": {
    "lib/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "react-native-builder-bob": {
    "source": "lib",
    "output": "dist",
    "targets": [
      [
        "commonjs"
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript"
      ]
    ]
  }
}
